# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tolgaakay.com

# --- Transactional email (Ask a Question / Consultancy notifications) ---
# Create a free account at https://resend.com, verify your sending domain,
# then set these. Until set, submissions are still saved (see DATABASE_URL
# below or the local file fallback) but no email notification is sent.
RESEND_API_KEY=
ASK_QUESTION_TO_EMAIL=tolgaakay616@gmail.com
CONSULTANCY_TO_EMAIL=tolgaakay616@gmail.com

# --- Form submissions storage (recommended: Supabase Postgres) ---
# Create a free project at https://supabase.com, run the SQL in
# /supabase/schema.sql, then set these. Until set, submissions fall back
# to being appended to a local JSON file (development only — not durable
# on most serverless hosts, so set this before going to production).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Newsletter (Weekly Ruminant Nutrition Notes) ---
# Buttondown (https://buttondown.email) is a good fit for a single-author
# technical newsletter. Leave blank to keep the signup form disabled.
BUTTONDOWN_API_KEY=

# --- Spam protection ---
# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/) —
# free, privacy-friendlier alternative to reCAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics ---
# Plausible (https://plausible.io) — privacy-respecting, no cookie banner needed.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Phase 2: Sanity CMS (see /src/sanity) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
